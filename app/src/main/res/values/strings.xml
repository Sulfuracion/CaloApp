    <!-- Pantalla Acerca de -->
    <string name="about_title">Acerca de ControlCal</string>
    <string name="about_app_description">ControlCal es una aplicación de registro y ajuste nutricional local-first, privada y sin publicidad. Toda tu información se almacena cifrada en tu dispositivo y nunca se comparte.</string>
    <string name="about_off_title">Open Food Facts</string>
    <string name="about_off_description">Esta aplicación consulta la base de datos de Open Food Facts para obtener la información nutricional de los productos escaneados. Open Food Facts es una base de datos abierta, libre y colaborativa creada por voluntarios de todo el mundo.</string>
    <string name="about_license_title">Licencia de datos (ODbL)</string>
    <string name="about_license_description">La base de datos de Open Food Facts está disponible bajo la Licencia de Base de Datos Abierta (ODbL - Open Database License) v1.0 de Open Data Commons. Los contenidos individuales de los productos están disponibles bajo la Database Contents License (DbCL).</string>
    <string name="about_off_web_action">Visitar Open Food Facts</string>
    <string name="about_odbl_license_action">Ver licencia ODbL</string>
    <string name="about_off_attribution_note">Agradecemos profundamente a la comunidad y a los contribuidores de Open Food Facts su esfuerzo para hacer accesible la información sobre los alimentos.</string>

